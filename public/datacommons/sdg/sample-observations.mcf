# Sample MCF with Observations for Testing
# Based on SDG Indicator: SI_POV_DAY1 (Poverty rate)

Node: dcid:undata/sdg/SI_POV_DAY1
typeOf: dcs:StatisticalVariable
measuredProperty: dcs:count
name: "Proportion of population below international poverty line"
description: "Percentage of population living on less than $2.15 per day (2017 PPP)"
populationType: dcs:Person
statType: dcs:measuredValue
unit: "Percentage"
measurementMethod: "HouseholdSurvey"

Node: dcid:undata/sdg/SI_POV_NAHC
typeOf: dcs:StatisticalVariable
measuredProperty: dcs:count
name: "Proportion of population living below the national poverty line"
description: "Percentage of population below national poverty line, by sex and age"
populationType: dcs:Person
statType: dcs:measuredValue
unit: "Percentage"
measurementMethod: "HouseholdSurvey"

