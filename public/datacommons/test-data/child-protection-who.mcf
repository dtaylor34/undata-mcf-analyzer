Node: dcid:who/infant_mortality_rate
typeOf: dcs:StatisticalVariable
name: "Infant mortality rate (per 1,000 live births)"
description: "Probability of dying between birth and exactly 1 year of age"
measuredProperty: dcs:mortalityRate
statType: dcs:measuredValue
populationType: dcs:Person
measurementQualifier: dcs:Infant

Node: dcid:who/child_mortality_1to4
typeOf: dcs:StatisticalVariable
