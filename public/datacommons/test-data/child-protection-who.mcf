# WHO Child Protection Data
# Theme: Children and Youth / Child Protection
# Focus: Child mortality and health indicators

Node: dcid:who_child_mortality_under5
typeOf: dcs:StatisticalVariable
name: "Under-5 mortality rate (per 1,000 live births)"
description: "Probability of dying between birth and exactly 5 years of age, expressed per 1,000 live births"
measuredProperty: dcs:mortalityRate
statType: dcs:measuredValue
populationType: dcs:Person
measurementQualifier: dcs:Under5Years

Node: dcid:who_neonatal_mortality
typeOf: dcs:StatisticalVariable
name: "Neonatal mortality rate (per 1,000 live births)"
description: "Number of deaths during the first 28 days of life per 1,000 live births"
measuredProperty: dcs:mortalityRate
statType: dcs:measuredValue
populationType: dcs:Person
measurementQualifier: dcs:Neonatal

