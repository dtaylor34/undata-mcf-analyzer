measuredProperty: dcs:lowBirthweight
statType: dcs:measuredValue
populationType: dcs:Person

Node: dcid:who/exclusive_breastfeeding_0to5m
typeOf: dcs:StatisticalVariable
name: "Exclusive breastfeeding rate (0-5 months) (%)"
measuredProperty: dcs:breastfeeding
