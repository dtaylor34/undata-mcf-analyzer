# MCF Test File: Child Protection - SDG Data
# Theme: Children and Youth > Child Protection
# Partner: United Nations SDG Database
# Indicators focused on birth registration and early marriage

# Statistical Variable: Birth registration (children under 5)
Node: dcid:sdg_birth_registration_under5
typeOf: dcs:StatisticalVariable
populationType: dcs:Person
measuredProperty: dcs:birthRegistration
statType: dcs:measuredValue
name: "Proportion of Children Whose Births Have Been Registered"
description: "Percentage of children under age 5 whose births are registered with a civil authority"
unit: dcs:Percent
age: "Under 5 years"

# Statistical Variable: Early marriage (before age 15)
Node: dcid:sdg_early_marriage_before15
typeOf: dcs:StatisticalVariable
populationType: dcs:Person
measuredProperty: dcs:earlyMarriage
statType: dcs:measuredValue
name: "Proportion of Women Married Before Age 15"
description: "Percentage of women aged 20-24 who were married or in a union before age 15"
unit: dcs:Percent
age: "20-24 years"
gender: "Female"

