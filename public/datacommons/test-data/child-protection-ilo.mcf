# Indicators focused on parental leave access

# Statistical Variable: Share of employees with access to parental leave
Node: dcid:ilo_parental_leave_access
typeOf: dcs:StatisticalVariable
populationType: dcs:Person
measuredProperty: dcs:parentalLeaveAccess
statType: dcs:measuredValue
name: "Share of Employees With Access to Parental Leave"
description: "Percentage of employees with access to parental leave in the World"
unit: dcs:Percent

# Observations - World aggregate data (2022)
