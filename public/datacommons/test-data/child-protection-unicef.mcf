# UNICEF Child Protection Data
# Theme: Children and Youth / Child Protection
# Focus: Immunization, education, and child welfare indicators

Node: dcid:unicef_immunization_dtp3
typeOf: dcs:StatisticalVariable
name: "DTP3 immunization coverage among 1-year-olds (%)"
description: "Percentage of children aged 12-23 months who received three doses of diphtheria-tetanus-pertussis vaccine"
measuredProperty: dcs:immunizationRate
statType: dcs:measuredValue
populationType: dcs:Person
measurementQualifier: dcs:Under2Years

Node: dcid:unicef_primary_school_completion
typeOf: dcs:StatisticalVariable
name: "Primary school completion rate (%)"
description: "Percentage of children completing primary education"
measuredProperty: dcs:educationCompletionRate
statType: dcs:measuredValue
populationType: dcs:Person
measurementQualifier: dcs:PrimarySchool

